<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened Runtime 例外：PyInstaller 打包的 Python 需要这些才能在公证后正常运行。
     allow-unsigned-executable-memory：ctypes/cffi 回调需要可写可执行内存；
     disable-library-validation：加载随包附带的、与主程序签名身份可能不同的 .so/.dylib。
     不需要沙盒（需要访问 USB 设备的 usbmuxd 套接字）。 -->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
